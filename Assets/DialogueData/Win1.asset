  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  Sentences:
  - Text: I got the right answer! Alright!
    emotion: 0
    name: Penny
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: Awesome job, kiddo! You guess my very personal lucky number! And you know
      what that means, right?
    emotion: 1
    name: Game Guy
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: I get the valuable riches?????
    emotion: 8
    name: Penny
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: That's right! Go inside this tent, and pick one of the three chests! Hope
      you pick something great!
    emotion: 1
    name: Game Guy
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: Now, I must go. My bed needs me.
    emotion: 0
    name: Game Guy
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
