MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f6fc8f370ee97db428fdd35074d55550, type: 3}
  m_Name: Keys1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  Sentences:
  - Text: Looks like I found the yellow triplet. She isn't in her house, though.
    emotion: 0
    name: Penny
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: You are correct, for I have found myself in quite the predicament.
    emotion: 2
    name: Yellow Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: What happened? I might be able to help.
    emotion: 0
    name: Penny
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: Well, you see, my lucky number is three, and it just so happens that my
      three house keys have gone missing.
    emotion: 2
    name: Yellow Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: Being locked out of your house is quite frowned upon in this town, so I
      must get them back.
    emotion: 2
    name: Yellow Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: I see. Well, I could try looking for the keys
    emotion: 0
    name: Penny
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: 'That would be splendid. Thank you so much! '
    emotion: 1
    name: Yellow Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: They have quite a shine to them, you'll know when you see them.
    emotion: 0
    name: Yellow Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  Character1: {fileID: 0}
  Character2: {fileID: 0}
  canPlayerMove: 1
  opening: 0
  minigameTransition: 0
  minigameNumber: 0
