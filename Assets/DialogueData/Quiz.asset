MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f6fc8f370ee97db428fdd35074d55550, type: 3}
  m_Name: Quiz
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  Sentences:
  - Text: Hey, it's the red triplet!
    emotion: 0
    name: Penny
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: You know it! It is time to begin my radical number game!
    emotion: 2
    name: Red Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: 'My lucky numbers are all single digit ones, so 0 through 9. They hold
      a special place in my heart. '
    emotion: 0
    name: Red Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: You know what else I hold dear in my heart? Standardized tests! You're
      taking one right now!
    emotion: 0
    name: Red Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: Are you serious? I already graduated, I'm done with tests!
    emotion: 4
    name: Penny
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: Don't worry, it's simple. You will get a series of five questions, and
      you must answer 0 through 9.
    emotion: 0
    name: Red Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: If you get 3 right, you win! If not, we restart! Here we go!
    emotion: 1
    name: Red Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: I guess I have no choice. Ah well, time to ace this test!
    emotion: 6
    name: Penny
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  Character1: {fileID: 0}
  Character2: {fileID: 0}
  canPlayerMove: 0
  opening: 0
  minigameTransition: 1
  minigameNumber: 1
  flyAway: 0
  gameOver: 0
