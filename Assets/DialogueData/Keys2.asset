  m_Name: Keys2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  Sentences:
  - Text: I found all of your keys, miss.
    emotion: 0
    name: Penny
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: Oh, thank you so much! I am forever in your debt.
    emotion: 1
    name: Yellow Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: Now me must begin the minigame of you handing me the keys!
    emotion: 1
    name: Yellow Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: I think I can just giv-
    emotion: 6
    name: Penny
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: No, no no, I insist! Minigame time!
    emotion: 1
    name: Yellow Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
