  m_Name: HigherLowerWin
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  Sentences:
  - Text: Alright, I did it!
    emotion: 1
    name: Penny
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: Congrats! You won. For that, you will get a piece of the game master's
      lucky number.
    emotion: 1
    name: Blue Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: The first two digits are 38.
    emotion: 1
    name: Blue Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: Access the pause menu to look at all the numbers you collected!
    emotion: 1
    name: Blue Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: I don't know what a pause menu is, but thanks!
    emotion: 1
    name: Penny
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
