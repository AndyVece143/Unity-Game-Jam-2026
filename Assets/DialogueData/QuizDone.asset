  Sentences:
  - Text: Awesome! I passed!
    emotion: 1
    name: Penny
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: You sure did! As a reward, you will get part of the game master's lucky
      number.
    emotion: 2
    name: Red Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: The third and fourth digits are 71.
    emotion: 0
    name: Red Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: Feel free to admire those numbers on the pause menu! It's a great way to
      pass the time!
    emotion: 0
    name: Red Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
