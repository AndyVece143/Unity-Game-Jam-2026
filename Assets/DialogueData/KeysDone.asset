  m_Name: KeysDone
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  Sentences:
  - Text: There, now you have all of your keys.
    emotion: 0
    name: Penny
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: Thank you so much! As thanks, I will tell you a bit of the game master's
      lucky number!
    emotion: 1
    name: Yellow Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: The fifth and sixth digits are 90.
    emotion: 0
    name: Yellow Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
  - Text: Check them out with the pause menu. Now if you'll excuse me, I have to
      return to the inside of my house!
    emotion: 0
    name: Yellow Triplet
    sound: {fileID: 8300000, guid: 5b6bfe88825810c4dabfb90539aad45e, type: 3}
