      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: dialogue1.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: dialogue2.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: 'dialogue1.Array.data[0]'
      value: Yoooooo! Do you like all my fridges? I know I do!
      objectReference: {fileID: 0}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: 'dialogue1.Array.data[1]'
      value: Nothing beats a big meal that's been sitting in the fridge for a week,
        it's great!
      objectReference: {fileID: 0}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: 'dialogue2.Array.data[0]'
      value: Hmm? Where do I sleep? Why, in one of the fridges, of course!
      objectReference: {fileID: 0}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: 'dialogue2.Array.data[1]'
      value: You see, I've always wanted to feel like dinner leftovers growing up,
        and this helps me do that!
      objectReference: {fileID: 0}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: 'dialogue2.Array.data[2]'
      value: Sure, I can barely breathe in there, and I get bad hypothermia, but
        who cares about the downsides?
      objectReference: {fileID: 0}
    - target: {fileID: 5614111530991891237, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: m_Name
      value: NPC (3)
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
