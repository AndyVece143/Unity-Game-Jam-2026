      propertyPath: m_Sprite
      value: 
      objectReference: {fileID: 5457266681764177437, guid: 0efec6e396faf874391cde3fa7802294, type: 3}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: dialogue1.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: dialogue2.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: 'dialogue1.Array.data[0]'
      value: This is like the twentieth time someone has walked into my house!
      objectReference: {fileID: 0}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: 'dialogue1.Array.data[1]'
      value: At least bring a housewarming gift or something!
      objectReference: {fileID: 0}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: 'dialogue1.Array.data[2]'
      value: The messed up part is that this festival goes on for like a week.
      objectReference: {fileID: 0}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: 'dialogue1.Array.data[3]'
      value: I just want my privacy back...
      objectReference: {fileID: 0}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: 'dialogue2.Array.data[0]'
      value: At least you're visiting during normal hours.
      objectReference: {fileID: 0}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: 'dialogue2.Array.data[1]'
      value: Last night, some asshole came in at 2 in the morning while I was sleeping.
      objectReference: {fileID: 0}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: 'dialogue2.Array.data[2]'
      value: And I couldn't do anything about it! Isn't that stupid?!
      objectReference: {fileID: 0}
    - target: {fileID: 5614111530991891237, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: m_Name
      value: NPC (2)
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
