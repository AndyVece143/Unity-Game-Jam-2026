    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: dialogue2.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: 'dialogue1.Array.data[0]'
      value: My mom is forcing me to go outside and enjoy this stupid festival.
      objectReference: {fileID: 0}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: 'dialogue1.Array.data[1]'
      value: I don't even like festivals! I just wanna play video games.
      objectReference: {fileID: 0}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: 'dialogue1.Array.data[2]'
      value: Wanna know what lucky number I want? The one that gets me the Fortnite
        Pirate Token!
      objectReference: {fileID: 0}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: 'dialogue2.Array.data[0]'
      value: Every minute I'm out here is a minute that I'm not grinding for the
        token.
      objectReference: {fileID: 0}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: 'dialogue2.Array.data[1]'
      value: I hear the chest noise in my sleep.
      objectReference: {fileID: 0}
    - target: {fileID: 5571950841072699475, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: 'dialogue2.Array.data[2]'
      value: Mom says I should get that checked out, but she'll never get it,
      objectReference: {fileID: 0}
    - target: {fileID: 5614111530991891237, guid: c2f25f6591d68bd48ad1ff3b6a93b501, type: 3}
      propertyPath: m_Name
      value: NPC (5)
      objectReference: {fileID: 0}
